UGA_BUS_DATABASE_URL=sqlite:////var/lib/uga-bus/uga_bus.sqlite3
UGA_BUS_DATA_DIR=/var/lib/uga-bus
UGA_BUS_VEHICLE_POLL_SECONDS=4
UGA_BUS_TRIP_UPDATE_POLL_SECONDS=5
UGA_BUS_ALERT_POLL_SECONDS=22
UGA_BUS_STATIC_POLL_SECONDS=3600
UGA_BUS_LEARNING_REFRESH_SECONDS=300
UGA_BUS_LEARNING_TIMEZONE=America/New_York
UGA_BUS_LEARNING_MIN_SEGMENT_SAMPLES=3
UGA_BUS_STALE_AFTER_SECONDS=45
UGA_BUS_DETAILED_OBSERVATION_RETENTION_DAYS=180
UGA_BUS_RAW_SNAPSHOT_RETENTION_DAYS=7
# Comma-separated only if serving a separate frontend origin.
UGA_BUS_CORS_ORIGINS=
# Set this before exposing /api/v1/diagnostics remotely.
UGA_BUS_DIAGNOSTICS_TOKEN=
